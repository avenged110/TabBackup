{
  "manifest_version": 3,
  "name": "TabBackup",
  "version": "1.0.1",
  "description": "Save every open tab's URL, grouped by window, to on-disk backups that can be restored. Automatic and manual backups with plain text export and import.",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "alarms",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabBackup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}